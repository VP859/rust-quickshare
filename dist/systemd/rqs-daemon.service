# systemd user service for the Ferry daemon (`rqs daemon`).
#
# Installation (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp rqs-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rqs-daemon.service
#   loginctl enable-linger "$USER"    # optional: keep running without a login session
#
# TICKET and logs: journalctl --user -u rqs-daemon -f
# Without a terminal the daemon only accepts files from Auto-Accept devices
# (rqs peer add <TICKET> --alias Laptop --auto-accept).

[Unit]
Description=Ferry – P2P file receiving daemon
Documentation=https://github.com/VP859/rust-quickshare
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The directories must exist before ReadWritePaths is applied ("+" = outside the sandbox).
ExecStartPre=+/usr/bin/mkdir -p %h/.config/rqs %h/Downloads
# Default cargo-dist install path; change to /usr/bin/rqs when installed from a package.
ExecStart=%h/.cargo/bin/rqs daemon
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Add your download folder here if it differs (default_download_dir in config.toml).
ReadWritePaths=%h/Downloads %h/.config/rqs
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=default.target
