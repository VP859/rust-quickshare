<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent (macOS) starting the RQS daemon at login.

  Installation (replaces __HOME__ with the home directory):
    sed "s|__HOME__|$HOME|g" com.rqs.daemon.plist > ~/Library/LaunchAgents/com.rqs.daemon.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rqs.daemon.plist

  Removal:
    launchctl bootout gui/$(id -u)/com.rqs.daemon && rm ~/Library/LaunchAgents/com.rqs.daemon.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rqs.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.cargo/bin/rqs</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/rqs-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/rqs-daemon.log</string>
</dict>
</plist>
