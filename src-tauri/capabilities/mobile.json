{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android permissions: file picker, notifications, clipboard and QR scanner",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "barcode-scanner:default"
  ]
}
