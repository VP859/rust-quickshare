<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by cloud backups or device-to-device transfers
     (Android 12+). The app data holds the device key (secret.key): a copy on
     another phone or in a cloud backup could pose as this device to its paired
     devices. A new phone pairs again instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
