{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "version": "0.2.3",
  "identifier": "io.github.vp859.ferry",
  "build": {
    "frontendDist": "./ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "cargo build --release -p ferry-cli --bin ferry"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ferry",
        "width": 920,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default", "mobile"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/ferry": "../target/release/ferry",
          "/usr/lib/systemd/user/ferry-daemon.service": "../dist/systemd/ferry-daemon.service"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/ferry": "../target/release/ferry",
          "/usr/lib/systemd/user/ferry-daemon.service": "../dist/systemd/ferry-daemon.service"
        }
      }
    }
  }
}
