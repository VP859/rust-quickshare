# Line endings: LF everywhere in the repository, whatever the platform's default.
# Files compared byte for byte by tests or hashed must not change when checked out on Windows.
* text=auto eol=lf
*.json text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.jar binary
