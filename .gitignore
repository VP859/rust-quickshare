# =============================================================================
# RQS P2P Quick Share – what does NOT go into the repository.
# Tracked: source code, configuration, documentation and files needed to build.
# =============================================================================

# ---- Rust: build artifacts --------------------------------------------------
target/
**/target/
# Cargo.lock is intentionally NOT ignored: this is an application, so the
# lockfile guarantees reproducible builds and belongs in the repository.

# ---- Packages and packaging output (cargo-dist, local builds) ----------------
dist-out/
*.tar.xz
*.tar.gz
*.zip
*.sha256
SHA256SUMS.txt
*.deb
*.rpm
*.AppImage
*.msi
*.exe
*.dmg
*.pkg
*.apk
*.aab
target/distrib/

# ---- Android: generated by Gradle / Tauri (not hand-written project files) -
**/.gradle/
**/.kotlin/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/buildSrc/build/
/src-tauri/gen/android/app/src/main/jniLibs/
/src-tauri/gen/android/app/src/main/assets/
/src-tauri/gen/android/app/src/main/java/com/rqs/quickshare/generated/
/src-tauri/gen/android/app/tauri.properties
/src-tauri/gen/android/app/tauri.build.gradle.kts
/src-tauri/gen/android/app/proguard-tauri.pro
/src-tauri/gen/android/tauri.settings.gradle
/src-tauri/gen/android/.tauri/
# Local SDK and signing settings – never in the repository.
local.properties
keystore.properties
*.jks
*.keystore
*.p12

# ---- Tauri: generated permission schemas (recreated on every build) ---------
/src-tauri/gen/schemas/

# ---- Secrets and local user configuration ------------------------------------
.env
.env.*
!.env.example
secret.key
*.pem
*.key
config.toml
.claude/settings.local.json

# ---- Test data and scratch files -------------------------------------------
*.part
*.log
*.tmp
*.bak
*.orig
*.rej
/tmp/
/scratch/
/rqs-test/
*.bin
!src-tauri/icons/**

# ---- Operating systems and editors -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
*.iml
.vscode/*
!.vscode/settings.json

# ---- Node (Tauri frontend / npm tooling) ------------------------------------
node_modules/
npm-debug.log*
package-lock.json
